<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>カフェ一覧ページ</title>
</head>
<body>
    <h1>カフェ一覧ページ</h1>
    <ul>
        <% for (cafe of cafes) { %>
            <li>
                <a href="/cafes/<%= cafe._id %>"><%= cafe.name %></a>
            </li>
        <% } %>
    </ul>
    
</body>
</html>