<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>カフェ新規登録ページ</title>
</head>
<body>
    <h1>カフェ新規登録</h1>
    <form action="/cafes/new" method="post">
        <div>
            <label for="name">名前</label>
            <input type="text" name="cafe[name]" id="name">
        </div>
        <div>
            <label for="price">価格</label>
            <input type="text" name="cafe[price]" id="price">
        </div>
        <button>登録</button>
    </form>
    
</body>
</html>